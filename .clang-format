---
BasedOnStyle: Google
Language: Cpp
Standard: c++20
IndentWidth: 4
ColumnLimit: 100
AccessModifierOffset: -4
DerivePointerAlignment: false
PointerAlignment: Left
AllowShortFunctionsOnASingleLine: Inline
IncludeBlocks: Regroup
IncludeCategories:
  # Project headers first ("module/header.hpp"), then third-party, then the standard library.
  - Regex: '^"'
    Priority: 1
  - Regex: '^<(gtest|gmock|benchmark)/'
    Priority: 2
  - Regex: '^<'
    Priority: 3
