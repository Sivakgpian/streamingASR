{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "gcc",
      "hidden": true,
      "cacheVariables": { "CMAKE_C_COMPILER": "gcc", "CMAKE_CXX_COMPILER": "g++" }
    },
    {
      "name": "clang",
      "hidden": true,
      "cacheVariables": { "CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++" }
    },
    { "name": "debug",   "hidden": true, "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "release", "hidden": true, "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    {
      "name": "asan",
      "hidden": true,
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "SASR_SANITIZER": "address,undefined" }
    },
    {
      "name": "tsan",
      "hidden": true,
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "SASR_SANITIZER": "thread" }
    },

    { "name": "gcc-debug",     "displayName": "GCC Debug",           "inherits": ["base", "gcc", "debug"] },
    { "name": "gcc-release",   "displayName": "GCC Release",         "inherits": ["base", "gcc", "release"] },
    { "name": "gcc-asan",      "displayName": "GCC ASan+UBSan",      "inherits": ["base", "gcc", "asan"] },
    { "name": "gcc-tsan",      "displayName": "GCC TSan",            "inherits": ["base", "gcc", "tsan"] },
    { "name": "clang-debug",   "displayName": "Clang Debug",         "inherits": ["base", "clang", "debug"] },
    { "name": "clang-release", "displayName": "Clang Release",       "inherits": ["base", "clang", "release"] },
    { "name": "clang-asan",    "displayName": "Clang ASan+UBSan",    "inherits": ["base", "clang", "asan"] },
    { "name": "clang-tsan",    "displayName": "Clang TSan",          "inherits": ["base", "clang", "tsan"] }
  ],

  "buildPresets": [
    { "name": "gcc-debug",     "configurePreset": "gcc-debug" },
    { "name": "gcc-release",   "configurePreset": "gcc-release" },
    { "name": "gcc-asan",      "configurePreset": "gcc-asan" },
    { "name": "gcc-tsan",      "configurePreset": "gcc-tsan" },
    { "name": "clang-debug",   "configurePreset": "clang-debug" },
    { "name": "clang-release", "configurePreset": "clang-release" },
    { "name": "clang-asan",    "configurePreset": "clang-asan" },
    { "name": "clang-tsan",    "configurePreset": "clang-tsan" }
  ],

  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    {
      "name": "test-asan",
      "hidden": true,
      "inherits": ["test-base"],
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:detect_stack_use_after_return=1:check_initialization_order=1:strict_string_checks=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    },
    {
      "name": "test-tsan",
      "hidden": true,
      "inherits": ["test-base"],
      "environment": { "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1" }
    },

    { "name": "gcc-debug",     "configurePreset": "gcc-debug",     "inherits": ["test-base"] },
    { "name": "gcc-release",   "configurePreset": "gcc-release",   "inherits": ["test-base"] },
    { "name": "gcc-asan",      "configurePreset": "gcc-asan",      "inherits": ["test-asan"] },
    { "name": "gcc-tsan",      "configurePreset": "gcc-tsan",      "inherits": ["test-tsan"] },
    { "name": "clang-debug",   "configurePreset": "clang-debug",   "inherits": ["test-base"] },
    { "name": "clang-release", "configurePreset": "clang-release", "inherits": ["test-base"] },
    { "name": "clang-asan",    "configurePreset": "clang-asan",    "inherits": ["test-asan"] },
    { "name": "clang-tsan",    "configurePreset": "clang-tsan",    "inherits": ["test-tsan"] }
  ],

  "workflowPresets": [
    { "name": "gcc-debug",     "steps": [ { "type": "configure", "name": "gcc-debug" },     { "type": "build", "name": "gcc-debug" },     { "type": "test", "name": "gcc-debug" } ] },
    { "name": "gcc-release",   "steps": [ { "type": "configure", "name": "gcc-release" },   { "type": "build", "name": "gcc-release" },   { "type": "test", "name": "gcc-release" } ] },
    { "name": "gcc-asan",      "steps": [ { "type": "configure", "name": "gcc-asan" },      { "type": "build", "name": "gcc-asan" },      { "type": "test", "name": "gcc-asan" } ] },
    { "name": "gcc-tsan",      "steps": [ { "type": "configure", "name": "gcc-tsan" },      { "type": "build", "name": "gcc-tsan" },      { "type": "test", "name": "gcc-tsan" } ] },
    { "name": "clang-debug",   "steps": [ { "type": "configure", "name": "clang-debug" },   { "type": "build", "name": "clang-debug" },   { "type": "test", "name": "clang-debug" } ] },
    { "name": "clang-release", "steps": [ { "type": "configure", "name": "clang-release" }, { "type": "build", "name": "clang-release" }, { "type": "test", "name": "clang-release" } ] },
    { "name": "clang-asan",    "steps": [ { "type": "configure", "name": "clang-asan" },    { "type": "build", "name": "clang-asan" },    { "type": "test", "name": "clang-asan" } ] },
    { "name": "clang-tsan",    "steps": [ { "type": "configure", "name": "clang-tsan" },    { "type": "build", "name": "clang-tsan" },    { "type": "test", "name": "clang-tsan" } ] }
  ]
}
